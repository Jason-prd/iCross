# ============================================
# iCross 跨境电商智能商业操作系统 - 环境变量配置
# ============================================
# 说明: 复制此文件为 .env 并根据环境修改配置
# ============================================

# ====================
# 1. 应用基础配置
# ====================

# 应用环境: development, testing, staging, production
APP_ENV=development

# 调试模式: true/false
APP_DEBUG=true

# 应用密钥 (生产环境必须更改!)
APP_SECRET_KEY=your-secret-key-change-in-production

# 应用名称
APP_NAME=iCross

# 应用版本
APP_VERSION=1.0.0

# ====================
# 2. 数据库配置 (PostgreSQL)
# ====================

# 开发环境数据库
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=icross_development
POSTGRES_USER=icross
POSTGRES_PASSWORD=icross123

# 测试环境数据库
# POSTGRES_HOST=test-postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=icross_test
# POSTGRES_USER=icross_test
# POSTGRES_PASSWORD=test123

# 生产环境数据库 (示例)
# POSTGRES_HOST=postgres-cluster.production.svc.cluster.local
# POSTGRES_PORT=5432
# POSTGRES_DB=icross_production
# POSTGRES_USER=icross_prod
# POSTGRES_PASSWORD=your-strong-production-password

# 数据库连接池配置
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=20
POSTGRES_POOL_TIMEOUT=30

# ====================
# 3. Redis配置
# ====================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis缓存TTL (秒)
REDIS_CACHE_TTL=300

# ====================
# 4. 消息队列配置 (Celery)
# ====================

# Celery Broker URL (使用Redis)
CELERY_BROKER_URL=redis://redis:6379/0

# Celery结果后端
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ====================
# 5. 对象存储配置 (MinIO/S3)
# ====================

# MinIO配置 (开发环境)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=icross-files

# AWS S3配置 (生产环境)
# AWS_S3_ENDPOINT=https://s3.amazonaws.com
# AWS_S3_ACCESS_KEY=your-access-key
# AWS_S3_SECRET_KEY=your-secret-key
# AWS_S3_BUCKET_NAME=icross-production
# AWS_S3_REGION=us-east-1

# ====================
# 6. 向量数据库配置 (Weaviate)
# ====================

WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_SCHEME=http
WEAVIATE_API_KEY=
WEAVIATE_EMBEDDINGS_MODEL=text-embedding-ada-002

# ====================
# 7. AI服务配置
# ====================

# OpenAI配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORGANIZATION=your-org-id
OPENAI_MODEL=gpt-4-turbo-preview

# Claude配置 (可选)
ANTHROPIC_API_KEY=your-claude-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# 文心一言配置 (可选)
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# Stable Diffusion配置 (可选)
STABLE_DIFFUSION_API_KEY=your-sd-api-key
STABLE_DIFFUSION_BASE_URL=https://api.stability.ai

# ====================
# 8. 第三方平台API配置
# ====================

# Ozon API配置
OZON_CLIENT_ID=your-ozon-client-id
OZON_API_KEY=your-ozon-api-key

# Amazon SP-API配置
AMAZON_CLIENT_ID=your-amazon-client-id
AMAZON_CLIENT_SECRET=your-amazon-client-secret
AMAZON_REFRESH_TOKEN=your-amazon-refresh-token
AMAZON_SELLING_PARTNER_ID=your-seller-id
AMAZON_MARKETPLACE_ID=your-marketplace-id

# Shopify配置
SHOPIFY_SHOP_NAME=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=your-shopify-access-token
SHOPIFY_API_VERSION=2024-01

# AliExpress配置 (v4.0扩展)
ALIEXPRESS_APP_KEY=your-ali-app-key
ALIEXPRESS_APP_SECRET=your-ali-app-secret
ALIEXPRESS_ACCESS_TOKEN=your-ali-access-token

# ====================
# 9. 邮件服务配置
# ====================

# SMTP配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_NAME=iCross System
SMTP_FROM_EMAIL=noreply@icross.com
SMTP_TLS=true

# ====================
# 10. 短信服务配置
# ====================

# Twilio配置 (可选)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# 阿里云短信配置 (可选)
ALIYUN_SMS_ACCESS_KEY_ID=your-aliyun-access-key
ALIYUN_SMS_ACCESS_SECRET=your-aliyun-secret
ALIYUN_SMS_SIGN_NAME=iCross
ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789

# ====================
# 11. 支付服务配置
# ====================

# Stripe配置 (国际支付)
STRIPE_API_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# 支付宝配置
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key

# 微信支付配置
WECHATPAY_MCH_ID=your-wechat-mch-id
WECHATPAY_API_KEY=your-wechat-api-key
WECHATPAY_CERT_PATH=/path/to/cert.pem
WECHATPAY_KEY_PATH=/path/to/key.pem

# ====================
# 12. 日志配置
# ====================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志输出: console, file, both
LOG_OUTPUT=both

# 日志文件路径
LOG_FILE_PATH=./logs/app.log

# 日志文件保留天数
LOG_RETENTION_DAYS=30

# ====================
# 13. 监控配置
# ====================

# Prometheus配置
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Sentry配置 (错误追踪)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Datadog配置 (可选)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# ====================
# 14. 安全配置
# ====================

# JWT配置
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS配置
CORS_ALLOW_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# 速率限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # 秒

# ====================
# 15. 前端配置
# ====================

# Vite开发服务器配置
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=iCross Development
VITE_APP_DESCRIPTION=跨境电商智能商业操作系统
VITE_APP_VERSION=1.0.0

# 前端功能开关
VITE_FEATURE_AI_CONTENT=true
VITE_FEATURE_MULTI_LANGUAGE=true
VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_ADVANCED_ANALYTICS=false

# ====================
# 16. 租户配置
# ====================

# 默认租户配置
DEFAULT_TENANT_ID=tenant_001
DEFAULT_TENANT_NAME=Default Tenant
DEFAULT_TENANT_DOMAIN=default.icross.com

# 多租户模式: shared, isolated
TENANT_MODE=shared

# ====================
# 17. 其他配置
# ====================

# 时区配置
TIMEZONE=Asia/Shanghai

# 默认语言
DEFAULT_LANGUAGE=zh-CN

# 支持的语言列表
SUPPORTED_LANGUAGES=["zh-CN", "en-US", "ru-RU", "es-ES"]

# 默认货币
DEFAULT_CURRENCY=USD

# 支持货币列表
SUPPORTED_CURRENCIES=["USD", "EUR", "GBP", "CNY", "RUB"]

# ============================================
# 环境特定配置
# ============================================

# 开发环境特定配置 (取消注释使用)
# DATABASE_URL=postgresql://icross:icross123@postgres:5432/icross_development
# REDIS_URL=redis://redis:6379/0

# 测试环境特定配置
# DATABASE_URL=postgresql://icross_test:test123@test-postgres:5432/icross_test
# REDIS_URL=redis://test-redis:6379/0

# 生产环境特定配置
# DATABASE_URL=postgresql://icross_prod:strong-password@postgres-cluster:5432/icross_production
# REDIS_URL=redis://redis-cluster:6379/0?password=your-redis-password

# ============================================
# 注意事项
# ============================================
# 1. 生产环境必须更改所有密钥和密码
# 2. 敏感信息不应提交到版本控制系统
# 3. 使用环境变量管理机密信息
# 4. 定期轮换API密钥和访问令牌
# ============================================